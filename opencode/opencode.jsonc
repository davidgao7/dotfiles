{
  "plugin": ["oh-my-openagent@latest"],
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "lsp":true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 32000
      },
      "models": {
        "qwen3-coder": {
          "name": "qwen3-coder:lastest"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "mlx-community/GLM-4.7-Flash-4bit": {
          "name": "GLM-4.7-Flash-4bit"
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (Qwen 35B-A3B Uncensored)",
      "options": {
        "baseURL": "http://localhost:8081/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.6-35b-a3b-uncensored": {
          "name": "Qwen3.6-35B-A3B Uncensored (Q6_K_P, 29GB)",
          "attachment": false,
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  "mode": {
    "build": {
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/build.txt}\n\n{file:./prompts/persona.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask"
      }
    },
    "plan": {
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/plan.txt}\n\n{file:./prompts/persona.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask"
      }
    }
  },
  "agent": {

    "security":{
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/security.txt}\n\n{file:./prompts/persona.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/review.txt}\n\n{file:./prompts/persona.txt}",
      "tools": {
        // Disable file modification tools for review-only agent
        "write": false,
        "edit": false,
        "webfetch": true
      },
      "permission": {
        "webfetch": "ask"
      }
    },
    "code-explorer": {
      "description": "Explores unfamiliar codebases to understand structure and functionality",
      "prompt": "{file:./prompts/explore.txt}\n\n{file:./prompts/persona.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "ask"
      }
    }
  },
  "mcp":{
    "exa": {
      "type": "remote",
      "url":"https://mcp.exa.ai/mcp",
      "enabled":true
    }
  }
}
