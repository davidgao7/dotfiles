{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 32000
      },
      "models": {
        "qwen3-coder": {
          "name": "qwen3-coder:lastest"
        },
        "qwen3.5": {
          "name": "qwen3.5:4b",
          "id": "qwen3.5:4b",
          "attachment": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "mlx-community/GLM-4.7-Flash-4bit": {
          "name": "GLM-4.7-Flash-4bit"
        }
      }
    }
  },
  "mode": {
    "build": {
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/build.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask",
        "task": {
          "vision": "allow"
        }
      }
    },
    "plan": {
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/plan.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask",
        "task": {
          "vision": "allow"
        }
      }
    }
  },
  "agent": {
    "security": {
      "prompt": "{file:./prompts/security.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "ask"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      // TODO: switch to opencode zen provider after spend all openrouter credits
      "prompt": "{file:./prompts/review.txt}",
      "tools": {
        // Disable file modification tools for review-only agent
        "write": false,
        "edit": false,
        "webfetch": true
      },
      "permission": {
        "webfetch": "ask"
      }
    },
    "code-explorer": {
      "description": "Explores unfamiliar codebases to understand structure and functionality",
      "prompt": "{file:./prompts/explore.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "webfetch": "ask"
      }
    },
    "team-manager": {
      "description": "MLOps/LLMOps software expert",
      "prompt": "{file:./prompts/team-management.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "webfetch": true,
        "grep": true,
        "glob": true,
        "list": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow"
      }
    },
    "vision": {
      "description": "Vision subagent. Reads and analyzes images using the local Qwen3.5-4B model over Ollama. Use this whenever the user asks about an image, pastes a screenshot, or references an image file. The main agent is text-only and cannot see images, so ALWAYS delegate image understanding to this subagent: pass the image file path in the task, let it read and describe the image, then relay its findings.",
      "mode": "subagent",
      "model": "ollama/qwen3.5",
      "reasoningEffort": "none",
      "prompt": "{file:./prompts/vision.txt}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "external_directory": "allow"
      }
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": [
        "uvx",
        "mcpo",
        "--port",
        8000,
        "--",
        "/Users/tengjungao/Downloads/web-search-lmstudio-mcp-no-limits/.venv/bin/python",
        "/Users/tengjungao/Downloads/web-search-lmstudio-mcp-no-limits/main.py"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_BASE_URL": "http://localhost:8000/search",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
